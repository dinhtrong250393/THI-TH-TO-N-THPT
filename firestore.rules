// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - displayName: string
//   - role: string (teacher|student) (required)
//   - createdAt: timestamp
//
// Collection: exams
// Fields:
//   - title: string (required)
//   - teacherId: string (required)
//   - questions: array (required)
//   - createdAt: timestamp
//
// Collection: submissions
// Fields:
//   - examId: string (required)
//   - studentId: string (required)
//   - studentName: string
//   - answers: map
//   - score: number
//   - wrongQuestionIds: array
//   - submittedAt: timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          (request.auth.token.email == "dinhtrong250393@gmail.com" && request.auth.token.email_verified == true));
    }

    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow create: if isAuthenticated() && request.resource.data.role in ['teacher', 'student'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isTeacher());
      allow create: if isStudent();
      allow update, delete: if false; // Submissions are immutable
    }
  }
}
